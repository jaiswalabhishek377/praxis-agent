# ============================================
# CentrAgent — Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- LLM Providers ---
# Primary: Google Gemini (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: Groq (optional, used on 429/failures)
GROQ_API_KEY=your_groq_api_key_here

# --- Agent Configuration ---
# Max steps before agent halts (safety net)
MAX_STEPS=30

# Show browser window during execution (true = headed, false = headless)
BROWSER_HEADLESS=false

# --- Mock App Configuration ---
ERP_PORT=3001
HEALTHCARE_PORT=3002

# --- Chaos Mode Toggles (for testing resilience) ---
# Set to "true" to enable
CHAOS_VALIDATION=false
CHAOS_SESSION=false
CHAOS_FLAKY=false

ERP_USER=admin
ERP_PASS=admin123

HEALTHCARE_USER=dr_admin
HEALTHCARE_PASS=health123

# Slow down browser actions (ms) so you can watch the agent work
BROWSER_SLOWMO=400
